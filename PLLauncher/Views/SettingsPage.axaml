<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PLLauncher.Views.SettingsPage"
             Background="{DynamicResource BackgroundBrush}">

    <DockPanel>
        <!-- Fixed bottom bar for Save / Discard buttons (docked first so ScrollViewer fills remaining space) -->
        <Border x:Name="BottomBar" DockPanel.Dock="Bottom" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,12">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <TextBlock x:Name="UnsavedHint" IsVisible="False" FontSize="13" VerticalAlignment="Center"
                           Foreground="{DynamicResource WarningBrush}" />
                <Button x:Name="DiscardButton" Click="DiscardChanges_Click" CornerRadius="6" Padding="16,12"
                        Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                        <TextBlock x:Name="DiscardButtonText" Text="Discard" FontSize="14" />
                    </StackPanel>
                </Button>
                <Button Click="SaveSettings_Click" CornerRadius="6" Padding="32,12"
                        Background="{DynamicResource AccentSecondaryBrush}" Foreground="White">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="16" />
                        <TextBlock x:Name="SaveButtonText" Text="Apply &amp; Save" FontSize="14" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        <!-- Scrollable content (filling child - no Dock set) -->
        <ScrollViewer Padding="32,28,32,8" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="700">
                <StackPanel Spacing="4">
                    <TextBlock x:Name="SettingsTitle" Text="Settings" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SettingsSubtitle" Text="Configure PLLauncher preferences" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- Language -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="LanguageSectionTitle" Text="Language" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="LanguageLabel" Text="Display language" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="LanguageDesc" Text="Applies after you save settings" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1" MinWidth="220"
                                      Background="{DynamicResource SurfaceBrush}"
                                      SelectionChanged="LanguageCombo_SelectionChanged">
                                <ComboBoxItem Content="English" Tag="en-US" />
                                <ComboBoxItem Content="Русский" Tag="ru-RU" />
                                <ComboBoxItem Content="中文 (简体)" Tag="zh-CN" />
                                <ComboBoxItem Content="Español" Tag="es-ES" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- General -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="GeneralSectionTitle" Text="General" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="StartupLabel" Text="Launch on Startup" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="StartupDesc" Text="Start PLLauncher when Windows starts" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" Grid.Column="1" IsChecked="True"
                                              IsCheckedChanged="StartupToggle_Changed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="TrayLabel" Text="Minimize to System Tray" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="TrayDesc" Text="Keep running in background" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="TrayToggle" Grid.Column="1" IsChecked="True"
                                              IsCheckedChanged="TrayToggle_Changed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="NotificationsLabel" Text="Show Notifications" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="NotificationsDesc" Text="Display Windows notifications" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="NotificationsToggle" Grid.Column="1" IsChecked="True"
                                              IsCheckedChanged="NotificationsToggle_Changed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="SearchHotkeyLabel" Text="Search Hotkey" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="SearchHotkeyDesc" Text="Keyboard shortcut to open search bar (e.g. Ctrl+K)" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBox x:Name="SearchHotkeyBox" Text="Ctrl+K" Width="160"
                                             IsReadOnly="True"
                                             Watermark="Press a key combination..."
                                             KeyDown="SearchHotkeyBox_KeyDown"
                                             PointerPressed="SearchHotkeyBox_PointerPressed"
                                             Cursor="Hand" />
                                    <CheckBox x:Name="SearchHotkeyEnabled" IsChecked="True"
                                              Content="Enabled" IsCheckedChanged="SearchHotkeyEnabled_Changed" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AppearanceSectionTitle" Text="Appearance" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="DarkModeLabel" Text="Dark Mode" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="DarkModeDesc" Text="Use dark theme (turn off for light theme)" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="DarkModeToggle" Grid.Column="1" IsChecked="True"
                                              IsCheckedChanged="DarkModeToggle_Changed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="AnimationsLabel" Text="Enable Animations" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="AnimationsDesc" Text="Smooth transitions and effects" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="AnimationsToggle" Grid.Column="1" IsChecked="True"
                                              IsCheckedChanged="AnimationsToggle_Changed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <StackPanel Spacing="8">
                                <TextBlock x:Name="AccentLabel" Text="Accent Color" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <StackPanel Orientation="Horizontal" x:Name="AccentColorsPanel">
                                    <Border x:Name="AccentBlue" Width="28" Height="28" CornerRadius="14" Background="#60CDFF" Margin="0,0,8,0"
                                            BorderThickness="2" PointerPressed="AccentColor_Click" Tag="Blue" Cursor="Hand" />
                                    <Border x:Name="AccentPurple" Width="28" Height="28" CornerRadius="14" Background="#BB86FC" Margin="0,0,8,0"
                                            BorderThickness="2" PointerPressed="AccentColor_Click" Tag="Purple" Cursor="Hand" />
                                    <Border x:Name="AccentGreen" Width="28" Height="28" CornerRadius="14" Background="#81C784" Margin="0,0,8,0"
                                            BorderThickness="2" PointerPressed="AccentColor_Click" Tag="Green" Cursor="Hand" />
                                    <Border x:Name="AccentOrange" Width="28" Height="28" CornerRadius="14" Background="#FFB74D" Margin="0,0,8,0"
                                            BorderThickness="2" PointerPressed="AccentColor_Click" Tag="Orange" Cursor="Hand" />
                                    <Border x:Name="AccentRed" Width="28" Height="28" CornerRadius="14" Background="#E57373" Margin="0,0,8,0"
                                            BorderThickness="2" PointerPressed="AccentColor_Click" Tag="Red" Cursor="Hand" />
                                    <Border x:Name="AccentCyan" Width="28" Height="28" CornerRadius="14" Background="#4DD0E1"
                                            BorderThickness="2" PointerPressed="AccentColor_Click" Tag="Cyan" Cursor="Hand" />
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#DDDDDD" BorderThickness="2"
                                            PointerPressed="CustomAccentColor_Click" Tag="Custom" Cursor="Hand" Margin="8,0,0,0">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="#333" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Performance -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="PerformanceSectionTitle" Text="Performance" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="16">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="PerformanceLabel" Text="Performance Mode" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="PerformanceDesc" Text="Reduce background CPU usage" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <ToggleSwitch x:Name="PerformanceToggle" Grid.Column="1"
                                              IsCheckedChanged="PerformanceToggle_Changed" />
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="WarningLabel" Text="Task Warning Time (min)" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="WarningDesc" Text="0 = no warning, else minutes before task to show popup" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <NumericUpDown x:Name="WarningTimeBox" Grid.Column="1" Value="1" Minimum="0" Maximum="30"
                                               ValueChanged="WarningTimeBox_Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Data Management -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="DataSectionTitle" Text="Data Management" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="ExportLabel" Text="Export Configuration" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="ExportDesc" Text="Save all data to JSON" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <Button x:Name="ExportButton" Grid.Column="1" Click="ExportConfig_Click" CornerRadius="6"
                                        Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                        <TextBlock x:Name="ExportButtonText" Text="Export" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="ImportLabel" Text="Import Configuration" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock x:Name="ImportDesc" Text="Restore from exported file" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <Button x:Name="ImportButton" Grid.Column="1" Click="ImportConfig_Click" CornerRadius="6"
                                        Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                        <TextBlock x:Name="ImportButtonText" Text="Import" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource BorderBrush}" />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2"><TextBlock x:Name="ResetLabel" Text="Reset All Data" FontWeight="Medium" Foreground="{DynamicResource ErrorBrush}" />
                                    <TextBlock x:Name="ResetDesc" Text="Delete everything permanently" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                <Button x:Name="ResetButton" Grid.Column="1" Click="ResetSettings_Click" CornerRadius="6"
                                        Background="#33F44336" Foreground="{DynamicResource ErrorBrush}" BorderBrush="{DynamicResource ErrorBrush}" VerticalAlignment="Center" Padding="14,8">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                        <TextBlock x:Name="ResetButtonText" Text="Reset" FontSize="13" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Bugs & Ideas -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="FeedbackSectionTitle" Text="Feedback" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="FeedbackLabel" Text="Bugs &amp; Ideas" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="FeedbackDesc" Text="Report a bug, suggest a feature, or send feedback" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="FeedbackBtn" Grid.Column="1" Click="FeedbackBtn_Click" CornerRadius="6"
                                    Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Padding="16,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock x:Name="FeedbackBtnText" Text="Open" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About -->
                <StackPanel Spacing="8">
                    <TextBlock x:Name="AboutSectionTitle" Text="About" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="8" Padding="16"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock x:Name="VersionLabel" Text="PLLauncher" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock x:Name="VersionDesc" Text="PLLauncher" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Button x:Name="CheckUpdatesBtn" Grid.Column="1" Click="CheckUpdates_Click" CornerRadius="6"
                                    Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Padding="14,8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                                    <TextBlock x:Name="CheckUpdatesBtnText" Text="Check" FontSize="13" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="StatusMsg" IsVisible="False" FontSize="13" Foreground="{DynamicResource SuccessBrush}" />
                <Rectangle Height="200" Fill="Transparent" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
