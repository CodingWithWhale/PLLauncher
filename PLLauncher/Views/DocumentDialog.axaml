<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PLLauncher.Views.DocumentDialog"
        Title="PLLauncher"
        Width="680" Height="600"
        MinWidth="500" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardBackgroundBrush}">

    <Border CornerRadius="8" Padding="20" Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <StackPanel Spacing="16">
            <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="6" Padding="14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DocumentText" TextWrapping="Wrap" FontSize="13" LineHeight="20"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </ScrollViewer>
            </Border>
            <Button x:Name="CloseBtn" Click="Close_Click" CornerRadius="6" Content="Close"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource AccentSecondaryBrush}" Foreground="White" />
        </StackPanel>
    </Border>
</Window>
