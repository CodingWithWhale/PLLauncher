<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PLLauncher</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Publish properties for standalone .exe (no .NET runtime required) -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Version>2.7.1.0</Version>

    <FileVersion>2.7.1.0</FileVersion>

    <AssemblyVersion>2.7.1.0</AssemblyVersion>
    <Description>PLLauncher - Windows Automation Launcher</Description>
    <Product>PLLauncher</Product>
    <Company>PLLauncher</Company>
    <Copyright>Copyright © $(Year)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.*" />
    <PackageReference Include="SkiaSharp" Version="2.88.*" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <Content Include="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="..\terms.txt" LogicalName="PLLauncher.Assets.terms.txt" />
    <EmbeddedResource Include="..\terms_ru.txt" LogicalName="PLLauncher.Assets.terms_ru.txt" />
    <EmbeddedResource Include="..\terms_zh.txt" LogicalName="PLLauncher.Assets.terms_zh.txt" />
    <EmbeddedResource Include="..\terms_es.txt" LogicalName="PLLauncher.Assets.terms_es.txt" />
    <EmbeddedResource Include="..\privacy.txt" LogicalName="PLLauncher.Assets.privacy.txt" />
    <EmbeddedResource Include="..\privacy_ru.txt" LogicalName="PLLauncher.Assets.privacy_ru.txt" />
    <EmbeddedResource Include="..\privacy_zh.txt" LogicalName="PLLauncher.Assets.privacy_zh.txt" />
    <EmbeddedResource Include="..\privacy_es.txt" LogicalName="PLLauncher.Assets.privacy_es.txt" />
  </ItemGroup>
</Project>
