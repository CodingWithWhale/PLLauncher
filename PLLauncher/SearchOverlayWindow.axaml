<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PLLauncher.Models"
        x:Class="PLLauncher.SearchOverlayWindow"
        ShowInTaskbar="False"
        Topmost="True"
        WindowState="Maximized"
        SystemDecorations="None"
        Background="#80000000"
        PointerPressed="Window_PointerPressed">

    <Border MaxWidth="500" VerticalAlignment="Top" Margin="0,120,0,0"
            Background="{DynamicResource SurfaceBrush}"
            CornerRadius="12" Padding="0"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            PointerPressed="SearchCard_PointerPressed">
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,14"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Margin="12,0,0,0"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             Watermark="Search actions..."
                             TextChanged="SearchTextBox_TextChanged"
                             KeyDown="SearchTextBox_KeyDown" />
                </Grid>
            </Border>
            <ListBox x:Name="SearchResultsList" MaxHeight="300"
                     Background="Transparent" BorderThickness="0"
                     SelectionChanged="SearchResultsList_SelectionChanged">
                 <ListBox.ItemTemplate>
                     <DataTemplate DataType="models:SearchAction">
                         <Border Padding="16,10">
                             <StackPanel Orientation="Horizontal" Spacing="12">
                                 <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                            Foreground="{DynamicResource AccentBrush}" />
                                 <TextBlock Text="{Binding Title}" FontSize="14"
                                            Foreground="{DynamicResource TextPrimaryBrush}" />
                             </StackPanel>
                         </Border>
                     </DataTemplate>
                 </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
